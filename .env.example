# NuvCode Backend — .env
#
# Format: NUV_<SECTION>__<FIELD> (double underscore = nested field)
# Config priority: env var (NUV_) > config/config.toml
#
# NOTE: the AXUM_ prefix is the old name and no longer read. Use NUV_.

# ── Server ─────────────────────────────────────────────
NUV_SERVER__HOST=0.0.0.0
NUV_SERVER__PORT=7444
# NUV_SERVER__PUBLIC_URL=http://192.168.8.103:7444

# ── Database ────────────────────────────────────────────
NUV_DATABASE__URL=postgresql://nuvcode:***@localhost/nuvcode

# ── Gateway ─────────────────────────────────────────────
NUV_GATEWAY__TIMEOUT_SECS=120

# ── Auth ──────────────────────────────────────────
NUV_AUTH__ADMIN_USERNAME=admin
NUV_AUTH__ADMIN_PASSWORD=change-me
NUV_AUTH__JWT_SECRET=change-me-too

# ── Logging ─────────────────────────────────────────────
RUST_LOG=info
# RUST_LOG_FORMAT=json
